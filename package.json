{
  "name": "adiloopgames",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/web && mkdir -p dist && cp -r dist/apps/web/* dist/ 2>/dev/null || true",
    "start": "npm run start --prefix apps/web",
    "lint": "npm run lint --prefix apps/web"
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "knip": "^6.32.1"
  },
  "workspaces": [
    "apps/*"
  ]
}
